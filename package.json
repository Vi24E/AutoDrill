{
  "name": "autodrill",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @autodrill/web dev",
    "build": "pnpm --filter @autodrill/web build",
    "lint": "pnpm --filter @autodrill/web lint",
    "typecheck": "pnpm --filter @autodrill/web typecheck",
    "test": "pnpm --filter @autodrill/web test",
    "toolchain:check": "./scripts/verify-toolchain.sh",
    "verify:next-output": "./scripts/verify-next-output-isolation.sh",
    "contract:check": "node scripts/sync-web-contract.mjs && node scripts/sync-web-wire-types.mjs",
    "contract:generate": "node scripts/sync-web-contract.mjs --write && node scripts/sync-web-wire-types.mjs --write",
    "wasm:ensure": "./scripts/ensure-wasm.sh",
    "dev:cache": "./scripts/ensure-next-dev-cache.sh",
    "pages:verify": "node scripts/verify-pages-export.mjs",
    "layout:verify": "node scripts/verify-browser-layout.mjs"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    }
  }
}
