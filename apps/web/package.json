{
  "name": "@autodrill/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "../../scripts/ensure-next-dev-cache.sh && ../../scripts/ensure-wasm.sh && pnpm contract:check && next dev",
    "build": "../../scripts/ensure-wasm.sh && pnpm contract:check && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm contract:check && next typegen && tsc --noEmit",
    "test": "vitest run",
    "contract:check": "node ../../scripts/sync-web-contract.mjs && node ../../scripts/sync-web-wire-types.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "mathlive": "0.110.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
